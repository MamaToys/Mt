# ─── Core ────────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, RDS, Vercel Postgres, ...)
DATABASE_URL="postgresql://user:password@localhost:5432/profit"
# Public base URL of this deployment (used for OAuth redirects and webhooks)
APP_URL="http://localhost:3000"

# ─── Auth (better-auth) ─────────────────────────────────────────────────────
# 32+ random bytes, e.g. `openssl rand -base64 32`
AUTH_SECRET=
# Set to "false" to disable public sign-up after the owner account exists
ALLOW_SIGNUP="true"

# ─── Encryption of stored platform tokens ───────────────────────────────────
# 32 bytes, base64 encoded: `openssl rand -base64 32`
# Shopify / Meta access tokens are AES-256-GCM encrypted with this key at rest.
TOKEN_ENCRYPTION_KEY=

# ─── Shopify (Admin API) ────────────────────────────────────────────────────
# OAuth app (Partner dashboard / Dev Dashboard). Redirect URL:
#   ${APP_URL}/api/integrations/shopify/callback
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION="2026-07"
SHOPIFY_SCOPES="read_orders,read_all_orders,read_products,read_inventory"
# Optional: single-store custom app token instead of OAuth.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# ─── Meta Marketing API ─────────────────────────────────────────────────────
# Redirect URL: ${APP_URL}/api/integrations/meta/callback
META_APP_ID=
META_APP_SECRET=
META_API_VERSION="v24.0"
# Optional: a system-user token instead of OAuth (needs ads_read).
META_ACCESS_TOKEN=

# ─── AI analysis (Anthropic Claude) ─────────────────────────────────────────
AI_API_KEY=
AI_MODEL="claude-opus-5-5"

# ─── Scheduled sync ─────────────────────────────────────────────────────────
# Vercel Cron sends `Authorization: Bearer ${CRON_SECRET}`
CRON_SECRET=
# Days of history imported on first connection
INITIAL_HISTORY_DAYS="730"
